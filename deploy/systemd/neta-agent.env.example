# NETA always-on service environment example.
# Copy to /etc/neta/neta-agent.env and keep the deployed file mode 0600.

NETA_FLEET_STATE_DIR=/var/lib/neta/identity
NETA_FLEET_REPORTING_MODE=SIGNIFICANT_ONLY
NETA_FLEET_MIN_CONFIDENCE=0.80
NETA_FLEET_REPORTING_COOLDOWN_SECONDS=1800
NETA_FLEET_HEARTBEAT_SECONDS=300
NETA_FLEET_HEARTBEAT_JITTER_PERCENT=20

# The always-on agent normally runs privileged for eBPF/process/socket visibility.
# Use a shared TLS context endpoint so instrumented applications running as
# non-root users can send exact OpenSSL TLS-session evidence to the same collector.
# Instrumented applications must be launched with the same value.
NETA_TLS_CONTEXT_SOCKET=@neta-agent-tls-service
